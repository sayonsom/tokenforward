@@ -246,3 +246,57 @@ class Proxy:
 DEFAULT_TIMEOUT_CONFIG = Timeout(timeout=5.0)
 DEFAULT_LIMITS = Limits(max_connections=100, max_keepalive_connections=20)
 DEFAULT_MAX_REDIRECTS = 20
+
+
+class Retry:
+    """
+    Retry configuration for clients.
+
+    **Usage**:
+
+    Retry()  # up to 3 retries with exponential backoff
+    Retry(0)  # disabled
+    """
+
+    def __init__(
+        self,
+        total: int = 3,
+        *,
+        backoff_factor: float = 0.5,
+        status_forcelist: typing.Iterable[int] = (429, 500, 502, 503, 504),
+        allowed_methods: typing.Iterable[str] = (
+            "GET", "HEAD", "OPTIONS", "PUT", "DELETE", "TRACE",
+        ),
+        respect_retry_after: bool = True,
+    ) -> None:
+        self.total = total
+        self.backoff_factor = backoff_factor
+        self.status_forcelist = tuple(status_forcelist)
+        self.allowed_methods = tuple(m.upper() for m in allowed_methods)
+        self.respect_retry_after = respect_retry_after
+
+    def backoff_for(self, attempt: int, response: typing.Any = None) -> float:
+        if self.respect_retry_after and response is not None:
+            value = response.headers.get("Retry-After", "")
+            if value.isdigit():
+                return int(value)
+        return self.backoff_factor * 2 ** (attempt - 1)
+
+    def _key(self) -> tuple[typing.Any, ...]:
+        return (self.total, self.backoff_factor, self.status_forcelist,
+                self.allowed_methods, self.respect_retry_after)
+
+    def __eq__(self, other: typing.Any) -> bool:
+        return isinstance(other, Retry) and self._key() == other._key()
+
+    def __repr__(self) -> str:
+        return (
+            f"Retry(total={self.total}, backoff_factor={self.backoff_factor}, "
+            f"status_forcelist={self.status_forcelist}, "
+            f"allowed_methods={self.allowed_methods}, "
+            f"respect_retry_after={self.respect_retry_after})"
+        )
+
+
+def to_retry(value: "int | Retry") -> Retry:
+    return value if isinstance(value, Retry) else Retry(total=int(value))
