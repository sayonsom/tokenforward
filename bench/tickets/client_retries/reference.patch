+    """
+    Retries were exhausted after repeated transport errors.
+    """
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        last_exception: Exception,
+        attempts: int,
+        request: Request | None = None,
+    ) -> None:
+        super().__init__(message, request=request)
